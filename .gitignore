# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
public/hero.mp4

# Local scratch space — throwaway scripts, notes and media. Some of these talk
# to the live database (clear-db.ts wipes collections), so they have no place
# in the repository. Already-tracked ones need untracking once:
#   git rm -r --cached scratch
scratch/

# Ad-hoc debug output. Redirected build logs kept landing here and being
# committed; they are stale within a day and can quote connection strings.
errors*.txt
*.log
