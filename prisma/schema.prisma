generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Config {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  key          String   @unique @default("current")
  value        Json     // Stores SiteConfig
  updatedAt    DateTime @updatedAt
}

model AboutContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique @default("current")
  value     Json     // Stores AboutContentT — see lib/about-schema.ts
  updatedAt DateTime @updatedAt
}

model HomeContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique @default("current")
  value     Json     // Stores HomeContentT — see lib/home-schema.ts
  updatedAt DateTime @updatedAt
}

/// One editable document per public page, keyed by slug. The singleton
/// content models above (Config, AboutContent, HomeContent) each hold exactly
/// one document and key on "current"; this table holds several, so the slug
/// is the identity — see lib/page-content/registry.ts for what each means.
model PageContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique // contact | membership | listings
  value     Json
  updatedAt DateTime @updatedAt
}

/// A live, admin-editable legal document (Impressum, Datenschutz, AGB, …).
/// `de` is the legally binding version; `en` is the courtesy translation for
/// the membership. Both hold a LegalContent JSON blob — see lib/legal-schema.ts.
model LegalDocument {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  slug            String   @unique // imprint | privacy | terms | withdrawal | cookies | accessibility
  version         Int      @default(1)
  requiresConsent Boolean  @default(false) // does a new version re-prompt members?
  isPublished     Boolean  @default(true)
  effectiveFrom   DateTime @default(now())
  de              Json
  en              Json
  changeNote      String? // shown verbatim in the re-consent modal
  revisions       LegalRevision[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Immutable snapshot of a published version. Never updated, never deleted —
/// this is what proves *which wording* a member actually agreed to.
model LegalRevision {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  documentId  String        @db.ObjectId
  document    LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  slug        String
  version     Int
  de          Json
  en          Json
  changeNote  String?
  publishedAt DateTime      @default(now())
  publishedBy String?

  @@unique([slug, version])
}

/// Art. 7(1) GDPR accountability record: who agreed to what, when, and how.
/// `userId` is null for anonymous subjects (contact form), which are keyed by
/// a hashed email in `subjectKey`. IPs are stored hashed, never raw.
model UserConsent {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?   @db.ObjectId
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectKey String // userId, or sha256(email) for anonymous subjects
  type       String // DOCUMENT | COOKIE | BIOMETRIC | PHOTO
  slug       String? // document slug, for type = DOCUMENT
  version    Int?
  granted    Boolean   @default(true)
  source     String // signup | reconsent | membership | registration | contact | profile
  ipHash     String?
  userAgent  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, slug])
  @@index([subjectKey])
}

/// Cookie banner choice for anonymous visitors. Mirrored in the first-party
/// `ksa_consent` cookie; the row exists so the choice is provable server-side.
model CookieConsent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  consentId     String   @unique // nanoid, also written to the cookie
  categories    Json // { essential, functional, media }
  policyVersion Int
  userAgent     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Event {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  slug           String         @unique
  title          String
  description    String
  date           DateTime
  startTime      String?
  endTime        String?
  location       String
  address        String?
  imageUrl       String?
  category       String?
  price          String?
  memberPrice    Float?
  nonMemberPrice Float?
  isFeatured     Boolean        @default(false)
  isPublished    Boolean        @default(false)
  requiresLogin  Boolean        @default(false)
  maxAttendees   Int?

  /// Whether the event is still going ahead.
  ///
  /// There was previously no way to say "this is off" — an event could only be
  /// deleted, which threw away the registrations along with the ability to tell
  /// anybody. Cancelling keeps the row and its registrations so the notice can
  /// be sent and the record survives.
  status             EventStatus @default(SCHEDULED)
  /// Shown verbatim to registrants in the cancellation notice.
  cancellationReason String?
  cancelledAt        DateTime?

  registrations  Registration[]
  galleryAlbum   GalleryAlbum?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum EventStatus {
  SCHEDULED
  POSTPONED
  CANCELLED
}


model Registration {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId     String   @unique // nanoid
  eventId      String   @db.ObjectId
  event        Event    @relation(fields: [eventId], references: [id])
  name         String
  email        String
  phone        String?
  attendees    Int      @default(1)
  isCheckedIn  Boolean  @default(false)
  checkInTime  DateTime?
  pricePaid     Float?
  paymentStatus String   @default("PENDING") // PENDING, PAID
  paymentMethod String   @default("CASH")    // CASH, BANK_TRANSFER
  currency      String   @default("EUR")
  details       Json?

  // --- Offline payment record. There is no gateway: an administrator states
  // that the money arrived, and these three fields are the whole audit trail.
  /// When the money actually arrived. May be backdated by the administrator.
  paidAt           DateTime?
  /// Bank transfer reference or receipt number.
  paymentReference String?
  /// The administrator who recorded it, and when they pressed the button —
  /// distinct from `paidAt`, which they may set to a past date.
  recordedById     String?   @db.ObjectId
  recordedAt       DateTime?

  createdAt     DateTime @default(now())

  @@unique([eventId, email])
  @@unique([eventId, phone])
}

model GalleryAlbum {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  category    String?        @default("Events")
  eventId     String?        @db.ObjectId @unique
  event       Event?         @relation(fields: [eventId], references: [id])
  coverImage  String?        // Cloudinary URL
  media       GalleryMedia[]
  contributions MediaContribution[]
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model GalleryMedia {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  albumId         String       @db.ObjectId
  album           GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  type            MediaType    @default(IMAGE)
  url             String
  publicId        String       @unique
  width           Int?
  height          Int?
  caption         String?
  faces           FaceDetection[] // Multiple faces per image
  createdAt       DateTime     @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
}

model FaceDetection {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  mediaId     String       @db.ObjectId
  media       GalleryMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  descriptor  Float[]      // 128-dimensional face encoding
  boundingBox Json?        // [x, y, width, height] for click-to-search UI
  createdAt   DateTime     @default(now())
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  password      String?   // Hashed password
  /// When the password was last changed. Sessions are stateless JWTs, so they
  /// cannot be deleted on a reset; tokens issued before this instant are
  /// rejected instead, which is what makes a reset actually evict an attacker.
  passwordChangedAt DateTime?
  role          String    @default("MEMBER")
  staffRoleId   String?   @db.ObjectId
  staffRole     Role?     @relation(fields: [staffRoleId], references: [id])
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  status        String    @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  phone         String?
  address       String?
  city          String?
  zip           String?
  dob           DateTime?
  occupation    String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  subscriptions Subscription[]
  contributions MediaContribution[]
  faceProfile   UserFaceProfile?

  // --- Privacy / GDPR ---
  consents            UserConsent[]
  /// Art. 17 erasure request. Financial records carry a statutory 10-year
  /// retention (§147 AO, §257 HGB), so erasure anonymises the profile rather
  /// than purging the rows — see `anonymizedAt`.
  deletionRequestedAt DateTime?
  anonymizedAt        DateTime?

  // --- Email preferences ---
  /// Opt-outs for *optional* mail only. Transactional mail — tickets, receipts,
  /// password resets, cancellation notices, anything the member needs in order
  /// to act — ignores these entirely and is never suppressible. Defaults are on
  /// because a member who joined an association expects to hear about it.
  emailEventAnnouncements Boolean @default(true)
  emailEventReminders     Boolean @default(true)
  emailNewsletter         Boolean @default(true)
  /// Token embedded in one-click unsubscribe links. Minted on first use so
  /// existing rows do not all need backfilling.
  ///
  /// Indexed but *not* unique. MongoDB treats a missing field as null for
  /// index purposes, so a unique index here fails to build against any
  /// existing collection — every member who has never been sent optional mail
  /// collides with every other. Uniqueness is not load-bearing anyway: the
  /// value is a 32-character nanoid, and lookups use `findFirst`.
  unsubscribeToken        String?

  @@index([unsubscribeToken])
}

/// Every send attempt, successful or not.
///
/// The system previously had no record that an email had been attempted: a
/// failure inside `sendEmail` was caught, logged to a console nobody reads, and
/// discarded, so a member who never got their ticket looked exactly like one
/// who did. This is the audit trail, the admin-visible failure list, and the
/// idempotency guard the scheduled jobs key on.
model EmailLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Template identifier, e.g. `event.ticket`, `membership.expiring-30`.
  template   String
  to         String
  subject    String
  /// QUEUED | SENT | FAILED | SUPPRESSED
  status     String   @default("QUEUED")
  provider   String? // resend | smtp
  providerId String? // Resend message id, for cross-referencing their dashboard
  error      String?
  attempts   Int      @default(0)
  /// The row this email is *about* — a registration, subscription, user or
  /// event id. Scheduled jobs check `(template, entityId)` before sending, so
  /// a cron that fires twice does not mail everyone twice.
  entityId   String?
  /// Rendered HTML, kept so an administrator can resend or inspect exactly
  /// what went out. Cleared by the retention job after 90 days.
  html       String?  @db.String
  createdAt  DateTime @default(now())
  sentAt     DateTime?

  @@index([template, entityId])
  @@index([status, createdAt])
  @@index([to])
}

model UserFaceProfile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId @unique
  user           User     @relation(fields: [userId], references: [id])
  descriptor     Float[]  // 128-dimensional face encoding
  updatedAt      DateTime @updatedAt
}

model MembershipPlan {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  duration    String   @default("YEARLY")
  features    String[]
  isActive    Boolean  @default(true)
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subscriptions Subscription[]
}

/// A membership term.
///
/// There is no payment gateway. A member applies, and the term only begins
/// when an administrator records that the money arrived — so `startDate` and
/// `endDate` are null until then. They used to be filled in at application
/// time, which made an unpaid application look like a running membership.
///
/// One row per term: a renewal is a new row, so each term keeps its own dates,
/// price and invoice.
model Subscription {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  user             User     @relation(fields: [userId], references: [id])
  planId           String   @db.ObjectId
  plan             MembershipPlan @relation(fields: [planId], references: [id])

  /// PENDING_VERIFICATION | AWAITING_PAYMENT | ACTIVE | REJECTED | EXPIRED | CANCELLED
  status           String   @default("AWAITING_PAYMENT")
  /// PENDING | PAID
  paymentStatus    String   @default("PENDING")
  /// BANK_TRANSFER | CASH — how the member said they intend to pay.
  paymentMethod    String   @default("BANK_TRANSFER")
  /// Student applications start false and flip when the ID is verified. That
  /// is *verification*, not payment: it never activates the membership.
  isApproved       Boolean  @default(false)

  /// Null until payment is recorded. `startDate` is the date the money
  /// arrived; `endDate` is that date plus the plan's duration.
  startDate        DateTime?
  endDate          DateTime?

  // --- Offline payment record (the audit trail the gateway used to provide) ---
  /// Bank transfer reference or receipt number.
  paymentReference String?
  /// Free-text note from the administrator who recorded the payment.
  paymentNote      String?
  /// Who pressed the button, and when. Separate from `startDate`, which the
  /// administrator may backdate to the day the cash was handed over.
  recordedById     String?   @db.ObjectId
  recordedAt       DateTime?

  details          Json?               // Store extra info like family members or student verification
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  email      String
  token      String   @unique
  expires    DateTime

  @@unique([email, token])
}

model LeadershipMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  image     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaContribution {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  albumId     String   @db.ObjectId
  album       GalleryAlbum @relation(fields: [albumId], references: [id])
  type        MediaType @default(IMAGE)
  url         String
  publicId    String   @unique
  width       Int?
  height      Int?
  caption     String?
  status      ContributionStatus @default(PENDING)
  rejectionReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// `WebhookEvent` lived here: a unique index on Stripe's evt_… id, so a
// redelivered webhook could not create a second subscription. There is no
// gateway and no webhook endpoint any more, so there is nothing to deduplicate.
// The collection is dropped by scratch/migrate-offline-payments.ts.

/// Captcha challenges, held in the database rather than process memory.
///
/// The in-memory Map only worked when the process that issued a challenge also
/// verified it. Behind more than one instance — or on a serverless platform —
/// verification usually landed somewhere else and failed for legitimate users.
model Captcha {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  token   String   @unique
  code    String
  expires DateTime
}

/// Fixed-window counters for things where the limit is a security control
/// rather than politeness — sign-in attempts, password reset requests.
/// Shared across instances and survives a restart, unlike the in-memory one.
model RateLimit {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  key     String   @unique
  count   Int      @default(0)
  resetAt DateTime
}

/// A named bundle of permission keys.
///
/// `permissions` is ignored when `isSystem` is true: Super Admin's set is
/// computed from the live catalogue so a permission added in a later release
/// is never missing from the one role that must hold everything.
model Role {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String        @unique
  description String?
  permissions String[]
  isSystem    Boolean       @default(false)
  users       User[]
  invites     StaffInvite[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// A pending offer of staff access.
///
/// No User row is created until the invite is accepted, so a revoked invite
/// leaves nothing behind. The raw token exists only in the email — a read of
/// this collection yields no working links.
model StaffInvite {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  tokenHash   String    @unique
  roleId      String    @db.ObjectId
  role        Role      @relation(fields: [roleId], references: [id])
  invitedById String    @db.ObjectId
  expires     DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([expires])
}

/// Who did what. Written by the guard itself for any permission whose
/// `mutates` flag is set, so an action cannot go unlogged by omission.
model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?  @db.ObjectId
  /// Denormalised so the entry survives the actor's deletion or anonymisation.
  actorEmail String
  /// The permission key that authorised the call.
  action     String
  entity     String?
  entityId   String?
  summary    String
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}
